<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Diego.Telemetry.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/icon.png" ToolTipText="Xeneon HW Monitor" Clicked="OpenFromTray">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Open" Click="OpenFromTray"/>
            <NativeMenuItem Header="Start with Windows" ToggleType="CheckBox" IsChecked="True" Click="ToggleAutostartFromTray"/>
            <NativeMenuItem Header="Check for updates" Click="CheckFromTray"/>
            <NativeMenuItem Header="Exit" Click="ExitFromTray"/>
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
