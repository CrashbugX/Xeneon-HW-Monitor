<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>diego-telemetry-host</AssemblyName>
    <RootNamespace>Diego.Telemetry.Host</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Xeneon HW Monitor Host</Product>
    <Company>Xeneon</Company>
    <AssemblyTitle>Xeneon HW Monitor Host</AssemblyTitle>
    <Description>Read-only Windows telemetry host. Does not control fans.</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Diego.Telemetry.Core\Diego.Telemetry.Core.csproj" />
    <ProjectReference Include="..\Diego.Telemetry.Fake\Diego.Telemetry.Fake.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">
    <ProjectReference Include="..\Diego.Telemetry.LibreHardwareMonitor\Diego.Telemetry.LibreHardwareMonitor.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">
    <DefineConstants>$(DefineConstants);WINDOWS_LHM</DefineConstants>
  </PropertyGroup>
</Project>
